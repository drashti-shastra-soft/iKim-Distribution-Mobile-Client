<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="i_KimMobileClient.Pages.Accounts.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:i_KimMobileClient.CustomeControls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundImageSource="img_bg"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid
            Margin="15,15"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="15">
            <!--<Image Aspect="AspectFit" Source="img_bg" />-->

            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HeightRequest="25"
                HorizontalOptions="Start"
                Source="icon_back"
                Style="{StaticResource ImgSmall}"
                VerticalOptions="Start"
                WidthRequest="25">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>

            <Image
                Grid.Row="1"
                Aspect="AspectFit"
                HeightRequest="200"
                Source="img_resetpassword"
                WidthRequest="200" />

            <StackLayout Grid.Row="2">

                <Label
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource lblBold}"
                    Text="Change Your Password" />

                <Label
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    LineHeight="1"
                    Style="{StaticResource lblRegular}"
                    Text="You Can Now Change Your Password"
                    TextColor="{StaticResource AppGray}" />
            </StackLayout>

            <StackLayout Grid.Row="3" Spacing="10">
                <Label
                    FontFamily="segoeuiSemibold"
                    FontSize="15"
                    Style="{StaticResource lblsemiBold}"
                    Text="Current Password"
                    TextColor="#000000" />

                <Border
                    Padding="0,0,10,0"
                    Stroke="LightGray"
                    Style="{StaticResource ExtBorder}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ext:BorderlessEntry
                            x:Name="txtCurrentPassword"
                            IsPassword="True"
                            Placeholder="********"
                            ReturnType="Next"
                            Style="{StaticResource extEntry}" />
                        <Image
                            x:Name="iconCurrentPassword"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            Source="icon_hide"
                            Style="{StaticResource ImgSmall}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnToggleCurrentPassword" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
            </StackLayout>

            <StackLayout Grid.Row="4" Spacing="10">
                <Label
                    FontFamily="segoeuiSemibold"
                    FontSize="15"
                    Style="{StaticResource lblsemiBold}"
                    Text="New Password"
                    TextColor="#000000" />

                <Border
                    Padding="0,0,10,0"
                    Stroke="LightGray"
                    Style="{StaticResource ExtBorder}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ext:BorderlessEntry
                            x:Name="EntryNewPassword"
                            IsPassword="True"
                            Placeholder="********"
                            ReturnType="Next"
                            Style="{StaticResource extEntry}" />
                        <Image
                            x:Name="IconNewPassword"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            Source="icon_hide"
                            Style="{StaticResource ImgSmall}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnToggleNewPassword" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
            </StackLayout>

            <StackLayout Grid.Row="5" Spacing="10">
                <Label
                    FontFamily="segoeuiSemibold"
                    FontSize="15"
                    Style="{StaticResource lblsemiBold}"
                    Text="Confirm Password"
                    TextColor="#000000" />

                <Border
                    Padding="0,0,10,0"
                    Stroke="LightGray"
                    Style="{StaticResource ExtBorder}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ext:BorderlessEntry
                            x:Name="EntryConfirmPassword"
                            IsPassword="True"
                            Placeholder="********"
                            ReturnType="Done"
                            Style="{StaticResource extEntry}" />
                        <Image
                            x:Name="IconConfirmPassword"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            Source="icon_hide"
                            Style="{StaticResource ImgSmall}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnToggleConfirmPassword" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Border>
            </StackLayout>

            <Button
                Grid.Row="6"
                Margin="0,30,0,0"
                Clicked="BtnResetPassword_Tapped"
                Style="{StaticResource BtnPrimary}"
                Text="Change Password" />
        </Grid>
    </ScrollView>

</ContentPage>
