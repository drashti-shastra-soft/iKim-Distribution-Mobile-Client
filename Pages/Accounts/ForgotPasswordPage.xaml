<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="i_KimMobileClient.Pages.Accounts.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:i_KimMobileClient.CustomeControls"
    BackgroundColor="WhiteSmoke"
    BackgroundImageSource="img_bg"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid
            Margin="15,15"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="15">
            <!--<Image Aspect="AspectFit" Source="img_bg" />-->

            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HeightRequest="25"
                HorizontalOptions="Start"
                Source="icon_back"
                Style="{StaticResource ImgSmall}"
                VerticalOptions="Start"
                WidthRequest="25">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="BtnBack_tapped" />
                </Image.GestureRecognizers>
            </Image>

            <Image
                Grid.Row="1"
                Aspect="AspectFit"
                HeightRequest="200"
                Source="img_forgot"
                WidthRequest="200" />

            <StackLayout Grid.Row="2">

                <Label
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource lblBold}"
                    Text="Forgot Password" />

                <Label
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    LineHeight="1"
                    Style="{StaticResource lblRegular}"
                    Text="Reset your password to continue"
                    TextColor="{StaticResource AppGray}" />
            </StackLayout>

            <StackLayout Grid.Row="3" Spacing="10">
                <Label
                    FontFamily="segoeuiSemibold"
                    FontSize="15"
                    Style="{StaticResource lblsemiBold}"
                    Text="Email"
                    TextColor="#000000" />

                <Border
                    Padding="0,0,10,0"
                    Stroke="LightGray"
                    Style="{StaticResource ExtBorder}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ext:BorderlessEntry
                            x:Name="txtEmail"
                            Keyboard="Email"
                            Placeholder="abc@gmail.com"
                            Style="{StaticResource extEntry}" />
                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            Source="icon_mail"
                            Style="{StaticResource ImgSmall}" />
                    </Grid>
                </Border>
            </StackLayout>

            <Button
                Grid.Row="4"
                Margin="0,30,0,0"
                Clicked="BtnSendCode_Tapped"
                Style="{StaticResource BtnPrimary}"
                Text="Submit" />
        </Grid>
    </ScrollView>
</ContentPage>