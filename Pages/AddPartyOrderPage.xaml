        <Grid
            Grid.Row="2"
            Padding="15"
            BackgroundColor="#F7F8FA">
            <Border
                x:Name="BtnPlaceOrder"
                Background="#FF6B00"
                HeightRequest="56"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <Border.Shadow>
                    <Shadow
                        Brush="#FF6B00"
                        Opacity="0.35"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Image
                        HeightRequest="22"
                        Source="icon_cart.svg"
                        VerticalOptions="Center"
                        WidthRequest="22">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Place Party Order"
                        TextColor="White"
                        VerticalOptions="Center" />
