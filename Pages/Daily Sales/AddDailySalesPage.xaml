                <!-- Notes -->

                <!--<HorizontalStackLayout 
                    Spacing="5">
                    <Label 
                        Text="Notes"
                        FontSize="14"
                        Style="{StaticResource lblBold2}"/>

                    <Label 
                        Text="(Optional)"
                        TextColor="#3A7DFF"
                        FontSize="14"
                        Style="{StaticResource lblBold2}"/>
                </HorizontalStackLayout>

                <Border
                     Padding="5,0"
                     Background="White"
                     Stroke="LightGray"
                     StrokeShape="{RoundRectangle CornerRadius=10}"
                     StrokeThickness="0.5">
