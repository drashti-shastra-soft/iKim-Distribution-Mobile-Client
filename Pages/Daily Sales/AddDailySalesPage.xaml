                    <ext:BorderlessEditor
                         x:Name="EntryNotes"
                         AutoSize="TextChanges"
                         Background="Transparent"
                         FontSize="14"
                         MaximumHeightRequest="100"
                         MinimumHeightRequest="80"
                         Placeholder="Enter notes here..."
                         PlaceholderColor="#BDBDBD"
                         TextColor="#1A1A1A" />
                </Border>-->
            </VerticalStackLayout>
        </ScrollView>

        <!--  Submit Button  -->
        <Grid
             Grid.Row="2"
             Padding="15"
             BackgroundColor="#F7F8FA">
            <Border
                 x:Name="BtnPlaceOrder"
                 Background="#FF6B00"
                 HeightRequest="56"
                 StrokeShape="RoundRectangle 16"
                 StrokeThickness="0">
                <Border.Shadow>
                    <Shadow
                         Brush="#FF6B00"
                         Opacity="0.35"
                         Radius="12"
                         Offset="0,4" />
                </Border.Shadow>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label
                         x:Name="BtnLabel"
                         FontAttributes="Bold"
                         FontSize="16"
                         Text="Submit"
                         TextColor="White"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddDailySalesTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <ext:CustomLoaderView
             x:Name="loaderView"
             Grid.RowSpan="2"
             IsVisible="False" />
    </Grid>

</ContentPage>