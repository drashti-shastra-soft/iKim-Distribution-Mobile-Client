                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="2"
                                ClassId="PartyOrders"
                                HorizontalOptions="Center"
                                Spacing="5">
                                <Border
                                    Background="White"
                                    HeightRequest="70"
                                    Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1"
                                    WidthRequest="70">
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.05"
                                            Radius="5"
                                            Offset="0,2" />
                                    </Border.Shadow>
                                    <Image
                                        HeightRequest="35"
                                        HorizontalOptions="Center"
                                        Source="icon_orangedeliveri"
                                        VerticalOptions="Center"
                                        WidthRequest="35" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource lblsemiBold}"
                                    Text="Party Orders"
                                    TextColor="{StaticResource AppColor2}" />
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="BdrQuickAction_Tapped" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>-->
                        </Grid>
                    </VerticalStackLayout>

                    <!--  Sale Overview  -->
                    <Border
                        Padding="20"
                        Background="White"
                        Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.05"
                                Radius="5"
                                Offset="0,2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Style="{StaticResource lblsemiBold}"
                                    Text="Sale Overview"
                                    TextColor="{StaticResource AppColor2}"
                                    VerticalOptions="Center" />

                                <!--  Period dropdown styled as rounded gray pill using MAUI Picker  -->
                                <Border
                                    Grid.Column="1"
                                    Margin="0"
                                    Padding="8,0"
                                    Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Grid
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="4">
                                        <ext:BorderlessPicker
                                            x:Name="periodPicker"
                                            Grid.Column="0"
                                            Margin="0"
                                            FontSize="12"
                                            SelectedIndex="2"
                                            SelectedIndexChanged="PeriodPicker_SelectedIndexChanged"
                                            TextColor="#000000"
                                            WidthRequest="80">
                                            <ext:BorderlessPicker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>This Day</x:String>
                                                    <x:String>This Week</x:String>
                                                    <x:String>This Month</x:String>
                                                </x:Array>
                                            </ext:BorderlessPicker.ItemsSource>
                                        </ext:BorderlessPicker>
                                        <Image
                                            Grid.Column="1"
                                            Aspect="AspectFit"
                                            HeightRequest="10"
                                            InputTransparent="True"
                                            Source="icon_downarrow"
                                            VerticalOptions="Center"
                                            WidthRequest="10" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnPickerTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Style="{StaticResource lblBold}"
                                Text="{Binding TotalSalesDisplay}"
                                TextColor="#000000" />
                            <HorizontalStackLayout Spacing="5">
                                <Border
                                    Padding="5,2"
                                    Background="{Binding PercentBadgeColor}"
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0">
                                    <Label
                                        FontSize="10"
                                        Text="{Binding PercentChangeDisplay}"
                                        TextColor="{Binding PercentTextColor}" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    Text="{Binding PeriodComparisonLabel}"
                                    TextColor="#757575"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <chart:SfCartesianChart
                                x:Name="salesChart"
                                Margin="0,15,0,0"
                                HeightRequest="180">

                                <chart:SfCartesianChart.XAxes>
                                    <chart:CategoryAxis ShowMajorGridLines="False" />
                                </chart:SfCartesianChart.XAxes>

                                <chart:SfCartesianChart.YAxes>
                                    <chart:NumericalAxis ShowMajorGridLines="True" />
                                </chart:SfCartesianChart.YAxes>

                                <chart:SfCartesianChart.TooltipBehavior>
                                    <chart:ChartTooltipBehavior Background="Transparent" />
                                </chart:SfCartesianChart.TooltipBehavior>

                                <chart:SfCartesianChart.ZoomPanBehavior>
                                    <chart:ChartZoomPanBehavior
                                        EnableDoubleTap="True"
                                        EnablePanning="True"
                                        EnablePinchZooming="True" />
                                </chart:SfCartesianChart.ZoomPanBehavior>

                                <chart:SplineAreaSeries
                                    x:Name="salesSeries"
                                    EnableTooltip="True"
                                    Fill="#FFF3E0"
                                    ItemsSource="{Binding ChartEntries}"
                                    ShowMarkers="True"
                                    Stroke="#FF6B00"
                                    StrokeWidth="3"
                                    XBindingPath="Label"
                                    YBindingPath="Value">

                                    <chart:SplineAreaSeries.MarkerSettings>
                                        <chart:ChartMarkerSettings
                                            Width="8"
                                            Height="8"
                                            Fill="#FF6B00"
                                            Type="Circle" />
                                    </chart:SplineAreaSeries.MarkerSettings>

                                    <chart:SplineAreaSeries.TooltipTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout
                                                Padding="8"
                                                BackgroundColor="White"
                                                Spacing="2">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="{Binding Item.Label}" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <BoxView
                                                        HeightRequest="10"
                                                        WidthRequest="10"
                                                        Color="#00BCD4" />
                                                    <Label FontSize="12" Text="{Binding Item.Value, StringFormat='Sales: {0}'}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </chart:SplineAreaSeries.TooltipTemplate>
                                </chart:SplineAreaSeries>
                            </chart:SfCartesianChart>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </RefreshView>
</ContentView>