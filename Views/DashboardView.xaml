                                        WidthRequest="30">
                                        <Image
                                            Margin="0,0,5,0"
                                            HorizontalOptions="Center"
                                            Source="icon_order"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
