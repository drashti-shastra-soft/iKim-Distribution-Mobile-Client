                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource lblsemiBold}"
                                        Text="Today Orders"
                                        TextColor="{StaticResource AppColor2}" />
                                </Grid>
                            </Border>

                            --><!--  Orange Card  --><!--
                            <Border
                                Grid.Column="1"
                                Padding="10"
                                Background="#FFCC80"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="5"
                                    VerticalOptions="Center"
                                    RowDefinitions="Auto, Auto">
                                    <Border
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Padding="3"
                                        Background="#FFD892"
                                        HeightRequest="30"
                                        StrokeShape="{RoundRectangle CornerRadius=8}"
                                        VerticalOptions="Center"
                                        WidthRequest="30">
                                        <Image
                                            Margin="0,0,5,0"
                                            HorizontalOptions="Center"
                                            Source="icon_delivery"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="13"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource lblsemiBold}"
                                        Text="08"
                                        TextColor="{StaticResource AppColor2}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource lblsemiBold}"
                                        Text="Pending Delivery"
                                        TextColor="{StaticResource AppColor2}" />
                                </Grid>
                            </Border>

                            --><!--  Blue Card  --><!--
                            <Border
                                Grid.Column="2"
                                Padding="10"
                                Background="#90CAF9"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="5"
                                    VerticalOptions="Center"
                                    RowDefinitions="Auto, Auto">
                                    <Border
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Padding="3"
                                        Background="#8FB3F2"
                                        HeightRequest="30"
                                        StrokeShape="{RoundRectangle CornerRadius=8}"
                                        VerticalOptions="Center"
                                        WidthRequest="30">
                                        <Image
                                            Margin="0,0,5,0"
                                            HorizontalOptions="Center"
                                            Source="icon_earnings"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="13"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource lblsemiBold}"
                                        Text="8,000"
                                        TextColor="{StaticResource AppColor2}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource lblsemiBold}"
                                        Text="Today Earnings"
                                        TextColor="{StaticResource AppColor2}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>-->

                    <!--  Quick Actions  -->
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontSize="16"
                            Style="{StaticResource lblBold}"
                            Text="Quick Actions"
                            TextColor="Black" />
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <VerticalStackLayout
                                Grid.Column="0"
                                ClassId="New Order"
                                HorizontalOptions="Center"
                                Spacing="5">
                                <Border
                                    Background="White"
                                    HeightRequest="70"
                                    Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1"
                                    WidthRequest="70">
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.05"
                                            Radius="5"
                                            Offset="0,2" />
                                    </Border.Shadow>
                                    <Image
                                        HeightRequest="35"
                                        HorizontalOptions="Center"
                                        Source="icon_daily_sales.png"
                                        VerticalOptions="Center"
                                        WidthRequest="35" >
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#FF6B00" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource lblsemiBold}"
                                    Text="Daily Sales"
                                    TextColor="{StaticResource AppColor2}" />
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="BdrDailySales_Tapped" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!--<VerticalStackLayout
                                Grid.Column="1"
                                ClassId="View Orders"
                                HorizontalOptions="Center"
                                Spacing="5">
                                <Border
                                    Background="White"
                                    HeightRequest="70"
                                    Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1"
                                    WidthRequest="70">
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.05"
                                            Radius="5"
                                            Offset="0,2" />
                                    </Border.Shadow>
                                    <Image
                                        HeightRequest="35"
                                        HorizontalOptions="Center"
                                        Source="icon_vieworders"
                                        VerticalOptions="Center"
                                        WidthRequest="35" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource lblsemiBold}"
                                    Text="View Orders"
