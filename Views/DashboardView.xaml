<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="i_KimMobileClient.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
    xmlns:conv="clr-namespace:i_KimMobileClient.Converter"
     xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:ext="clr-namespace:i_KimMobileClient.CustomeControls">
    <RefreshView
        x:Name="OrderRefreshView"
        Grid.Row="1"
        Command="{Binding RefreshCommand}"
        RefreshColor="#FF6B00"
        Refreshing="OnRefreshing">
        <Grid RowDefinitions="Auto,*">

            <!--  Top Gradient Area  -->
            <Grid
                Padding="20,20,20,20"
                ColumnDefinitions="Auto, *, Auto,Auto"
                RowDefinitions="Auto, Auto, Auto">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#FD872A" />
                        <GradientStop Offset="0.5" Color="#FD9F54" />
                        <GradientStop Offset="1.0" Color="#F7F8FA" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!--  Profile Info  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="#A5E0C2"
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 25"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="50">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="50"
                        Source="profile"
                        WidthRequest="50" />
                </Border>

                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    Spacing="5"
                    VerticalOptions="Center">
                    <Label
                        FontSize="18"
                        Style="{StaticResource lblsemiBold}"
                        Text="Welcome"
                        TextColor="#000000" />
                    <Label
                        x:Name="lblUserName"
                        FontSize="18"
                        Style="{StaticResource lblsemiBold}"
                        TextColor="#000000" />
                </HorizontalStackLayout>

                <Border
                    x:Name="bdrNotification"
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="10"
                    Background="White"
                    HeightRequest="45"
                    StrokeShape="RoundRectangle 22.5"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="45">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        Source="notification"
                        VerticalOptions="Center"
                        WidthRequest="40" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="BdrNotification_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border
                     x:Name="bdrNotificationCount"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,5,-8,30"
                    Padding="0"
                    Background="#E53935"
                    HeightRequest="20"
                    HorizontalOptions="End"
                    StrokeShape="{RoundRectangle CornerRadius=10}"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    WidthRequest="20">
                    <Label
                        x:Name="lblNotification"
                        FontSize="9"
                        HorizontalOptions="Center"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <!--  Banners Carousel  -->
                <CarouselView
                    x:Name="bannerCarousel"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="-20,20,-20,0"
                    HeightRequest="140"
                    IndicatorView="indicatorView"
                    Loop="True"
                    PeekAreaInsets="20">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,12,0"
                                Padding="0"
                                HeightRequest="140"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">
                                <Grid>
                                    <Image Aspect="AspectFill" Source="{Binding ImageSourceValue}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <!--  Pagination Dots  -->
                <IndicatorView
                    x:Name="indicatorView"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Margin="0,15,0,0"
                    HorizontalOptions="Center"
                    IndicatorColor="#D3D3D3"
                    IndicatorSize="8"
                    SelectedIndicatorColor="#FF6B00" />
            </Grid>

            <ScrollView
                Grid.Row="1"
                Padding="20,10,20,20"
                Background="White"
                VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="20">
                    <!--  Daily Action  -->
                    <!--<VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
